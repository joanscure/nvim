<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Perfil de formateo Eclipse/JDT usado por jdtls (java.lua) en vez de
  google-java-format. La clave es `join_wrapped_lines=false`: le dice al
  formateador que NO vuelva a juntar en una sola linea algo que vos ya
  partiste en varias a mano (que es justo lo que google-java-format SI
  hace, y por lo que se cambio). Los demas valores son solo para
  mantener el mismo estilo (2 espacios, 100 columnas) que ya se usaba.

  Solo se declaran las claves que nos importan; jdtls completa el resto
  con el perfil "Eclipse" por defecto.
-->
<profiles version="13">
<profile kind="CodeFormatterProfile" name="nvim-config" version="13">
<setting id="org.eclipse.jdt.core.formatter.tabulation.char" value="space"/>
<setting id="org.eclipse.jdt.core.formatter.tabulation.size" value="2"/>
<setting id="org.eclipse.jdt.core.formatter.indentation.size" value="2"/>
<setting id="org.eclipse.jdt.core.formatter.lineSplit" value="100"/>
<setting id="org.eclipse.jdt.core.formatter.join_wrapped_lines" value="false"/>
</profile>
</profiles>
